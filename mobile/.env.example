# Supabase project URL — found in Supabase dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon/public key — found in Supabase dashboard > Settings > API
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google Maps API key — from Google Cloud Console.
# NOTE: This is a single shared key for development. In production, use separate keys
# for iOS (restricted by Bundle ID) and Android (restricted by SHA-1 fingerprint)
# per the recommendations in mobile/docs/mobile-integration-research.md.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
